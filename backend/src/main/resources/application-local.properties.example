# (In STS: Run Configurations > Arguments > Program arguments)
spring.datasource.url=jdbc:mysql://localhost:3306/smartcrop?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.jpa.hibernate.ddl-auto=update
